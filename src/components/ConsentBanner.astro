---
// Consent banner (D-002, copy approved in D-018). Visits are counted without
// cookies by default; Accept adds cookies and session replay (inputs masked).
---

<div class="consent-banner" role="region" aria-label="Cookie choice" hidden>
	<div class="wrap consent-banner__inner">
		<p>
			We count visits to this page without cookies. Can we also use cookies and record your
			session (typing is always hidden) to see where the page is confusing?{' '}
			<a href="/privacy">Privacy policy</a>
		</p>
		<div class="consent-banner__actions">
			<button class="button" type="button" data-consent="accepted">Accept</button>
			<button class="button button--quiet" type="button" data-consent="declined">No thanks</button>
		</div>
	</div>
</div>

<script>
	import { startAnalytics, consentStatus, answerConsent } from '../lib/analytics';

	const page = (document.body.dataset.analytics ?? 'other') as 'landing' | 'preview' | 'other';
	startAnalytics(page);

	const banner = document.querySelector<HTMLElement>('.consent-banner');
	if (banner && consentStatus() === 'pending') banner.hidden = false;

	banner?.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((btn) =>
		btn.addEventListener('click', () => {
			answerConsent(btn.dataset.consent === 'accepted' ? 'accepted' : 'declined');
			banner.hidden = true;
		}),
	);
</script>

<style>
	.consent-banner {
		position: fixed;
		inset: auto 0 0 0;
		z-index: 20;
		padding-block: 1rem;
		background: var(--paper-raised);
		border-top: 1px solid var(--ink);
		box-shadow: 0 -4px 16px rgb(31 42 68 / 0.08);
		font-size: 0.95rem;
	}

	.consent-banner__inner {
		display: grid;
		gap: 0.75rem;
		align-items: center;
	}

	.consent-banner p {
		margin: 0;
		max-width: 46rem;
	}

	.consent-banner__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.button--quiet {
		background: transparent;
		color: var(--ink);
		box-shadow: inset 0 0 0 1px var(--ink);
	}

	.button--quiet:hover {
		background: var(--paper);
		color: var(--ink);
	}

	@media (min-width: 48rem) {
		.consent-banner__inner {
			grid-template-columns: 1fr auto;
			gap: 1.5rem;
		}
	}
</style>
