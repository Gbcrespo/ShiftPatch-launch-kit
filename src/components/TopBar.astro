---

<header class="topbar">
	<div class="wrap topbar__inner">
		<a class="wordmark" href="/">ShiftPatch</a>
		<span class="concept-label">Pre-launch concept</span>
	</div>
</header>

<style>
	.topbar {
		border-bottom: 1px solid var(--rule);
	}

	.topbar__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 3.75rem;
	}

	.wordmark {
		font-family: var(--serif);
		font-weight: 600;
		font-size: 1.3rem;
		color: var(--ink);
		text-decoration: none;
	}

	.concept-label {
		border: 1px solid var(--teal);
		border-radius: 999px;
		padding: 0.15rem 0.7rem;
		color: var(--teal-dark);
		background: var(--teal-tint);
		font-size: 0.875rem;
		font-weight: 600;
		white-space: nowrap;
	}
</style>
